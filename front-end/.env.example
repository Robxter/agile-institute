# Puerto del BFF Node (sirve dist/ y expone /api)
BFF_PORT=5174
# Centro de mando FastAPI al que el BFF delega el resto de /api
CDM_API_URL=http://127.0.0.1:8765
# Ruta del centro de mando (botón "Acceder" y accesos del cuadro de mando); el BFF la sirve en /app
VITE_APP_URL=/app
# Correo vía Resend (server/mail.mjs). Sin RESEND_API_KEY no se envía nada.
RESEND_API_KEY=
MAIL_FROM="Agile Institute™ <hola@tu-dominio-verificado.es>"
MAIL_TEAM_TO=equipo@tu-dominio.es
