# Demenova environment variables. Copy to .env and fill locally. Never commit .env.
# The same names go into GitHub encrypted secrets (pipeline) and Render environment (backend).

# NASA Earthdata (pipeline)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Supabase (anon key is public by design; service role key is server-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend build-time (Vite exposes only VITE_* variables to the app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email (backend)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM_NAME=Demenova Alerts

# Telegram (backend, nice-to-have)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Backend admin endpoints (/run, /email/test)
ADMIN_TOKEN=

# Python text encoding on Windows
PYTHONUTF8=1
